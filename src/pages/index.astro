---
import Base from "../layouts/Base.astro";
import siteInfo from "../lib/info"; // adjust path as needed
import { bioData } from '../lib/bio.ts';
import { visitPhrases } from '../lib/visits.ts';

// Pick a random phrase on load
const randomPhrase = visitPhrases[Math.floor(Math.random() * visitPhrases.length)];
const siteNote = `🇻🇪🇨🇦 ${randomPhrase}`;
---

<Base title={siteInfo.site.title} description={siteInfo.site.description}>

    <section class="container mx-auto px-6 py-16 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-6xl font-boldonse tracking-tight text-balance">
            {siteInfo.name}</h1>
            
            <!-- Role with inline / Person link -->
            <div class="mb-4 text-lg md:text-lg flex items-center gap-2">
                <span class="text-accent font-medium">{siteInfo.role}</span>
                <span class="text-muted-foreground">/</span>
                <a href={`${import.meta.env.BASE_URL}/personal`} class="text-muted-foreground underline underline-offset-2 hover:text-accent transition-colors">Person</a>
            </div>

            <p class="mb-4 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
    {bioData.intro} 
    {bioData.projects.map((project, index) => (
        <>
            <a
                href={project.href} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-accent underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"

            >{project.text}</a>{
                index === bioData.projects.length - 2 
                    ? " and " 
                    : index < bioData.projects.length - 1 
                        ? ", " 
                        : ""
            }
        </>
    ))}
    {bioData.outro}
        </p>
            <p class="mb-10 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty flex items-center gap-2">
                <span>{siteNote}</span>
            </p>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-lg">
                {siteInfo.contacts.map((contact) => (
                    <div>
                        [{contact.label}  <a
                            href={contact.href}
                            target={contact.target}
                            rel={contact.rel}
                            class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                        >{contact.text}</a> ] 
                    </div>
                ))}
            </div>
        </div>
    </section>

</Base>