---
import Base from "../layouts/Base.astro";
import personalInfo from "../lib/personal.json";
---

<Base title={`${personalInfo.name} - Person`} description="The more relaxed personal side.">

    <section class="container mx-auto px-6 py-16 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-6xl font-boldonse tracking-tight text-balance">{personalInfo.name}</h1>
            
            <div class="mb-4 text-lg md:text-xl text-muted-foreground flex items-center gap-2">
                <span>{personalInfo.role}</span>
                <span>/</span>
                <a href="/webpro" class="text-accent underline underline-offset-2 hover:text-foreground transition-colors">Motion Designer</a>
            </div>

            <p class="mb-4 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                {personalInfo.bio}
            </p>
            <p class="mb-10 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty flex items-center gap-2">
                <span>{personalInfo.note}</span>
            </p>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {personalInfo.contacts.map((contact) => (
                    <div>
                        [{contact.label}: <a
                            href={contact.href}
                            target={contact.target}
                            rel={contact.rel}
                            class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                        >{contact.text}</a>]
                    </div>
                ))}
            </div>
        </div>
    </section>

</Base>