---
import Base from "../layouts/Base.astro";
import siteInfo from "../lib/info"; // adjust path as needed
import { bioData, projectsList } from '../lib/bio.ts';
import { visitPhrases } from '../lib/visits.ts';

// Pick a random phrase on load
const randomPhrase = visitPhrases[Math.floor(Math.random() * visitPhrases.length)];
const siteNote = `🇻🇪🇨🇦 ${randomPhrase}`;
---

<Base title={`Projects — ${siteInfo.site.title}`} description="A collection of projects and immersive work.">

    <section class="container mx-auto px-6 py-16 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-6xl font-boldonse tracking-tight text-balance">
            {siteInfo.name}</h1>
            
            <!-- Role link back to Home without underline -->
            <div class="mb-8 text-lg md:text-lg flex items-center gap-2">
                <a 
                    href={import.meta.env.BASE_URL} 
                    class="text-accent font-medium hover:text-foreground transition-colors"
                >{siteInfo.role}</a>
                <span class="text-muted-foreground">/</span>
                <a href={`${import.meta.env.BASE_URL}/personal`} class="text-muted-foreground underline underline-offset-2 hover:text-accent transition-colors">Person</a>
            </div>

            <ul class="mb-12 space-y-3">
                {projectsList.map((project) => (
                    <li>
                        <a 
                            href={project.href} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="text-lg md:text-lg text-accent underline underline-offset-4 decoration-accent/50 hover:text-foreground hover:decoration-foreground transition-colors inline-flex items-center gap-2"
                        >
                            <span>{project.text}</span>
                            <span class="text-xs text-muted-foreground">↗</span>
                        </a>
                    </li>
                ))}
            </ul>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-lg">
                {siteInfo.contacts.map((contact) => {
                    const isProjects = contact.text.toLowerCase() === 'projects';
                    return (
                        <div>
                            [{contact.label} <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class={`${isProjects ? 'text-accent font-medium' : 'text-muted-foreground'} underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors`}
                            >{contact.text}</a> ] 
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

</Base>